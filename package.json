{
  "name": "infisical-action",
  "version": "0.0.2",
  "description": "A Github Action that allows you to consume infisical secrets as secure environment variables.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "local-action": "npx @github/local-action . src/main.ts .env"
  },
  "files": [
    "src/**/*",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amaneshi/infisical-action.git"
  },
  "keywords": [
    "infisical",
    "secrets",
    "github",
    "actions",
    "github-actions",
    "typescript"
  ],
  "author": "amaneshi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amaneshi/infisical-action/issues"
  },
  "homepage": "https://github.com/amaneshi/infisical-action#readme",
  "dependencies": {
    "got": "^15.0.5"
  },
  "peerDependencies": {
    "@actions/core": ">=3"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@types/node": "^25.9.1",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^5.9.3"
  }
}
